# Required WhatsApp credentials
SESSION_ID=
OWNER_NUMBER=
OWNER_NAME=
BOT_NAME=MUSHII
GOOGLE_API_KEY=
PAIR_CODE_API_URL=

# Bot behavior
PREFIX=.
MODE=public
THEME=mushii
AUTO_STATUS_SEEN=true
AUTO_STATUS_REACT=true
AUTO_TYPING=true
READ_MESSAGE=false

# Optional free AI auto-reply provider (requires a free OpenRouter account/key)
# Keep the key private; the bot also has no-key provider fallbacks.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free

# Optional Agent v2 provider
# Use an OpenAI-compatible provider endpoint.
AGENT_API_KEY=
AGENT_API_URL=https://api.openai.com/v1
AGENT_MODEL=gpt-4o-mini
AGENT_MAX_STEPS=5

# Optional encrypted Postgres storage. Set the connection string in your host
# secret panel, never in Git.
DATABASE_URL=

# Optional free-tier documentary research providers
YOUTUBE_API_KEY=
RESEARCH_DAILY_YOUTUBE_SEARCH_LIMIT=20
# MUSHII Life OS integrations (keep real values in ignored config.env only)
# Create an OAuth client in Google Cloud as a Desktop app and enable Drive API + Gmail API.
LIFE_OS_GOOGLE_CLIENT_ID=
LIFE_OS_GOOGLE_CLIENT_SECRET=
# Strong passphrase used to encrypt every Life OS backup before uploading to Drive.
# Keep a copy safely: without it, encrypted backups cannot be recovered.
LIFE_OS_BACKUP_PASSPHRASE=
# Optional destination for email reminders and daily/weekly report emails.
LIFE_OS_EMAIL_TO=
