# Required WhatsApp credentials
SESSION_ID=
OWNER_NUMBER=
OWNER_NAME=
BOT_NAME=MUSHII
GOOGLE_API_KEY=
PAIR_CODE_API_URL=

# Bot behavior
PREFIX=.
MODE=public
THEME=mushii
AUTO_STATUS_SEEN=true
AUTO_STATUS_REACT=true
AUTO_TYPING=true
READ_MESSAGE=false

# Optional Agent v2 provider
AGENT_API_KEY=
AGENT_API_URL=https://api.openai.com/v1
AGENT_MODEL=gpt-4o-mini
AGENT_MAX_STEPS=5

# Optional encrypted Postgres storage. Set the connection string in your host
# secret panel, never in Git.
DATABASE_URL=

# Creator Studio — optional free-tier research integrations
# Keep these values in this private config.env file. Never commit real keys.
YOUTUBE_API_KEY=
GEMINI_API_KEY=
CREATOR_GEMINI_MODEL=gemini-3.8-flash
CREATOR_YOUTUBE_SEARCH_DAILY_LIMIT=20
CREATOR_YOUTUBE_UNITS_DAILY_LIMIT=9000
CREATOR_GEMINI_REQUESTS_DAILY_LIMIT=10
# Optional absolute path for local SQLite storage.
# CREATOR_DB_PATH=
